GEMINI_API_KEY=your_gemini_api_key_here

# ── 칸반 DB (선택) ─────────────────────────────────────────────
# 미설정 시 로컬 SQLite(KANBAN_DB_PATH 또는 기본 kanban.db)를 읽는다.
# 설정 시 PostgreSQL/Supabase를 읽는다. 목적은 단일 사용자 다기기 동기화(인증/RLS 없음).
# 실제 값은 .env에만 두고 커밋하지 말 것.
KANBAN_DB_HOST=
KANBAN_DB_PORT=5432
KANBAN_DB_USER=ai_board_user
KANBAN_DB_PASSWORD=********
KANBAN_DB_NAME=ai_board
# 로컬 SQLite 경로 오버라이드 (미설정 시 자동 탐지)
KANBAN_DB_PATH=
